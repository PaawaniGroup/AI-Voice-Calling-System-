# MME_TELEPHONY environment template. Copy to .env (never commit .env). All values are placeholders.
# Full reference: docs/CONFIGURATION_REFERENCE.md


# ---- AI (Phase 3, must stay off) ----
# Comma-separated host allowlist for model/RAG URLs set through the dashboard.
MME_TEL_AI_ALLOWED_HOSTS=127.0.0.1,localhost
# Bearer key sent to model servers (secret; never shown in the UI).
MME_TEL_AI_API_KEY=
# Brain/LLM model identifier.
MME_TEL_AI_BRAIN_MODEL=Qwen3-30B-A3B-Instruct-2507
# Global AI switch. Default off. Even when true, an AI session only starts when the media bridge is ready.
MME_TEL_AI_ENABLED=False
# Max concurrent model requests per process.
MME_TEL_AI_MAX_CONCURRENCY=4
# Media bridge implementation. 'none' = not available (default). 'ws_fork' needs a FreeSWITCH media-fork module that is NOT installed on the audited host.
MME_TEL_AI_MEDIA_BRIDGE=none
# Default timeout for model service requests.
MME_TEL_AI_REQUEST_TIMEOUT_S=15.0
# STT model identifier (informational; the model server owns the weights).
MME_TEL_AI_STT_MODEL=Oriserve/Whisper-Hindi2Hinglish-Prime
# TTS model identifier.
MME_TEL_AI_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base

# ---- API/runtime ----
# API version prefix.
MME_TEL_API_PREFIX=/v1
# Service name used in logs/metrics.
MME_TEL_APP_NAME=mme-telephony
# Service version.
MME_TEL_APP_VERSION=0.2.0
# API bind address. Terminate TLS in front of it.
MME_TEL_BIND_HOST=127.0.0.1
# API port.
MME_TEL_BIND_PORT=8800
# Comma-separated allowed browser origins. Empty = CORS disabled.
MME_TEL_CORS_ORIGINS=
# Expose /docs and /openapi.json. Disable in production. [DEV ONLY]
MME_TEL_DOCS_ENABLED=True
# Deployment environment.
MME_TEL_ENV=development
# Maximum accepted request body.
MME_TEL_MAX_BODY_BYTES=65536
# Per-request timeout for outbound HTTP made by the service.
MME_TEL_REQUEST_TIMEOUT_S=30.0
# Graceful shutdown budget.
MME_TEL_SHUTDOWN_TIMEOUT_S=15.0
# Comma-separated CIDRs allowed to set X-Forwarded-For. Empty = none.
MME_TEL_TRUSTED_PROXIES=
# Uvicorn workers. MUST be 1: the controller owns the ESL event stream.
MME_TEL_WORKERS=1

# ---- Auth/security ----
# JWT algorithm.
MME_TEL_JWT_ALGORITHM=HS256
# Expected 'aud' claim; empty disables the check.
MME_TEL_JWT_AUDIENCE=
# Expected 'iss' claim; empty disables the check.
MME_TEL_JWT_ISSUER=
# Claim carrying the role list.
MME_TEL_JWT_ROLES_CLAIM=roles
# HS256 verification secret shared with MME identity (secret). Required.
MME_TEL_JWT_SECRET=
# Claim carrying the tenant id.
MME_TEL_JWT_TENANT_CLAIM=tenant_id
# Lifetime of tokens issued by /v1/auth/login.
MME_TEL_JWT_TTL_S=28800
# Bearer token required for /metrics. Empty = loopback clients only.
MME_TEL_METRICS_TOKEN=
# Per-tenant POST /calls per minute.
MME_TEL_RATE_LIMIT_CALL_CREATE_PER_MIN=30
# Per-principal API requests/minute.
MME_TEL_RATE_LIMIT_PER_MIN=120
# Role granting tenant-admin operations.
MME_TEL_ROLE_ADMIN=telephony:admin
# Role granting cross-tenant/system admin operations.
MME_TEL_ROLE_PLATFORM=platform:admin
# Role granting call operations.
MME_TEL_ROLE_USER=telephony:user
# Read-only dashboard role.
MME_TEL_ROLE_VIEWER=telephony:viewer
# Require auth for /v1/telephony/status.
MME_TEL_STATUS_REQUIRES_AUTH=True
# Master key deriving per-endpoint outbound webhook secrets.
MME_TEL_WEBHOOK_SIGNING_MASTER=

# ---- Call control/queue ----
# Comma-separated ISO regions allowed by default.
MME_TEL_DEFAULT_ALLOWED_COUNTRIES=IN
# Premium/telemarketing prefixes always denied by default.
MME_TEL_DEFAULT_DENY_PREFIXES=+911860,+911900,+91140
# Region for parsing national-format numbers.
MME_TEL_DEFAULT_REGION=IN
# Dispatcher poll interval.
MME_TEL_DISPATCH_POLL_S=0.25
# Global max active calls.
MME_TEL_MAX_ACTIVE_GLOBAL=30
# Default per-tenant max active calls.
MME_TEL_MAX_ACTIVE_PER_TENANT=10
# Max originations/second (also bounded by provider_max_cps).
MME_TEL_MAX_INITIATION_RATE=1.0
# Max queued calls (global).
MME_TEL_MAX_QUEUED=200
# Queued calls older than this fail with queue_timeout.
MME_TEL_QUEUE_MAX_WAIT_S=300
# On capacity exhaustion: queue or reject (429).
MME_TEL_QUEUE_POLICY=queue

# ---- Database ----
# Connect timeout.
MME_TEL_MONGO_CONNECT_TIMEOUT_MS=5000
# Dedicated telephony database name.
MME_TEL_MONGO_DB=mme_telephony
# Create indexes/schema version on startup (idempotent).
MME_TEL_MONGO_INIT_INDEXES=True
# Max pool size.
MME_TEL_MONGO_MAX_POOL=50
# Min pool size.
MME_TEL_MONGO_MIN_POOL=0
# Server selection timeout.
MME_TEL_MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# MongoDB connection URI (secret). Required.
MME_TEL_MONGO_URI=
# Audit log retention.
MME_TEL_RETENTION_AUDIT_DAYS=365
# Call record retention.
MME_TEL_RETENTION_CALLS_DAYS=730
# Provider-callback replay/nonce window.
MME_TEL_RETENTION_DEDUP_HOURS=72
# Call event retention.
MME_TEL_RETENTION_EVENTS_DAYS=180
# Idempotency record retention.
MME_TEL_RETENTION_IDEMPOTENCY_HOURS=48
# Retention sweep interval.
MME_TEL_RETENTION_INTERVAL_S=3600

# ---- FreeSWITCH/ESL ----
# Allow a non-private ESL address. Requires security review.
MME_TEL_ESL_ALLOW_NON_PRIVATE=False
# Per ESL command timeout.
MME_TEL_ESL_COMMAND_TIMEOUT_S=10.0
# ESL connect+auth timeout.
MME_TEL_ESL_CONNECT_TIMEOUT_S=5.0
# Concurrent event handlers.
MME_TEL_ESL_EVENT_CONCURRENCY=8
# Event queue bound.
MME_TEL_ESL_EVENT_QUEUE_SIZE=10000
# ESL host. Must be loopback/private unless esl_allow_non_private=true.
MME_TEL_ESL_HOST=127.0.0.1
# No event/heartbeat for this long => connection considered dead.
MME_TEL_ESL_IDLE_TIMEOUT_S=60.0
# ESL password (secret). Required unless fs_enabled=false.
MME_TEL_ESL_PASSWORD=
# ESL port.
MME_TEL_ESL_PORT=8021
# Initial reconnect delay.
MME_TEL_ESL_RECONNECT_INITIAL_S=0.5
# Jitter fraction (0..1).
MME_TEL_ESL_RECONNECT_JITTER=0.25
# Max reconnect delay.
MME_TEL_ESL_RECONNECT_MAX_S=30.0
# Dial-string template. {gateway}, {destination} only. Test mode may use loopback.
MME_TEL_FS_DIAL_TEMPLATE=sofia/gateway/{gateway}/{destination}
# Enable the FreeSWITCH controller.
MME_TEL_FS_ENABLED=True
# FreeSWITCH gateway name used for PSTN legs.
MME_TEL_FS_GATEWAY=mme_carrier
# Dialplan context for inbound calls handled by the controller.
MME_TEL_FS_INBOUND_CONTEXT=mme_inbound
# Local spool dir for recordings.
MME_TEL_FS_RECORDINGS_DIR=/var/lib/mme_telephony/recordings
# Dial-string template used by the mme_transfer dialplan bridge.
MME_TEL_FS_TRANSFER_TEMPLATE=sofia/gateway/{gateway}/{destination}
# Max time in 'initiating' before declared failed.
MME_TEL_INITIATING_TIMEOUT_S=90
# Max calls per reconcile pass.
MME_TEL_RECONCILE_BATCH=200
# Do not finalize a call younger than this on reconcile.
MME_TEL_RECONCILE_GRACE_S=20.0
# Reconciliation sweep interval.
MME_TEL_RECONCILE_INTERVAL_S=30.0

# ---- Observability ----
# Log format.
MME_TEL_LOG_FORMAT=json
# Log level.
MME_TEL_LOG_LEVEL=INFO
# Readiness: FreeSWITCH heartbeat must be fresher than this.
MME_TEL_READY_MAX_EVENT_AGE_S=120.0
# Reserved; tracing not implemented.
MME_TEL_TRACING_ENABLED=False

# ---- Other ----
# Serve the management dashboard at /dashboard.
MME_TEL_DASHBOARD_ENABLED=True
# Recent warning/error log records kept in memory for the dashboard.
MME_TEL_ERROR_LOG_BUFFER=500
# Enable POST /v1/auth/login (local users in MongoDB, scrypt hashes).
MME_TEL_LOGIN_ENABLED=True
# Failed+successful login attempts per client IP per minute.
MME_TEL_LOGIN_RATE_LIMIT_PER_MIN=10
# Comma-separated FreeSWITCH contexts (e.g. 'public') whose inbound calls are RECORDED ONLY (call+session created for numbers with an inbound route; nothing is answered/rejected/bridged).
MME_TEL_OBSERVE_CONTEXTS=

# ---- Outbound webhooks ----
# Deliver outbound lifecycle webhooks.
MME_TEL_WEBHOOKS_ENABLED=True
# Permit http:// destinations. [DEV ONLY]
MME_TEL_WEBHOOK_ALLOW_HTTP=False
# Permit private/loopback destinations (SSRF protection off). [DEV ONLY]
MME_TEL_WEBHOOK_ALLOW_PRIVATE=False
# Backoff base (exponential, jittered).
MME_TEL_WEBHOOK_BACKOFF_BASE_S=5.0
# Backoff cap.
MME_TEL_WEBHOOK_BACKOFF_MAX_S=3600.0
# Concurrent deliveries.
MME_TEL_WEBHOOK_CONCURRENCY=8
# Connect timeout.
MME_TEL_WEBHOOK_CONNECT_TIMEOUT_S=3.0
# Max delivery attempts before dead-letter.
MME_TEL_WEBHOOK_MAX_ATTEMPTS=8
# Max pending deliveries before new ones are dropped+alerted.
MME_TEL_WEBHOOK_QUEUE_LIMIT=50000
# Read timeout.
MME_TEL_WEBHOOK_READ_TIMEOUT_S=10.0

# ---- Provider ----
# Estimated carrier rate/minute used ONLY for estimates; 0 disables.
MME_TEL_ESTIMATE_RATE_PER_MIN=0.0
# Plivo Auth ID (secret).
MME_TEL_PLIVO_AUTH_ID=
# Plivo Auth Token (secret); also verifies webhook signatures.
MME_TEL_PLIVO_AUTH_TOKEN=
# Call path. 'mock' is rejected outside development/test.
MME_TEL_PROVIDER=freeswitch_gateway
# Reject provider callbacks older than this (nonce replay window).
MME_TEL_PROVIDER_CALLBACK_MAX_AGE_S=300
# Provider concurrency ceiling. VERIFY against the Plivo account.
MME_TEL_PROVIDER_MAX_CONCURRENT=10
# Provider calls-per-second ceiling. VERIFY against the account.
MME_TEL_PROVIDER_MAX_CPS=1.0
# Provider API timeout.
MME_TEL_PROVIDER_TIMEOUT_S=10.0
# Explicit opt-in to dial real PSTN numbers. Default off.
MME_TEL_REAL_CALLS_ENABLED=False
# Public HTTPS base URL Plivo calls back (no trailing slash).
MME_TEL_WEBHOOK_PUBLIC_BASE_URL=

# ---- Recording/storage ----
# Consent/disclosure mechanism. Required to record.
MME_TEL_RECORDING_CONSENT_MODE=
# Feature flag. Needs consent_mode + storage configured.
MME_TEL_RECORDING_ENABLED=False
# Max recording length.
MME_TEL_RECORDING_MAX_SECONDS=3600
# Recording retention.
MME_TEL_RECORDING_RETENTION_DAYS=90
# Presigned download URL lifetime.
MME_TEL_RECORDING_URL_TTL_S=300
# S3 bucket (operator supplied).
MME_TEL_S3_BUCKET=
# SSE-KMS key id; empty = SSE-S3 (AES256).
MME_TEL_S3_KMS_KEY_ID=
# S3 key prefix.
MME_TEL_S3_PREFIX=telephony/recordings/
# S3 region.
MME_TEL_S3_REGION=
# Upload retry attempts.
MME_TEL_S3_UPLOAD_RETRIES=3
# Upload timeout.
MME_TEL_S3_UPLOAD_TIMEOUT_S=60.0
# Recording storage backend.
MME_TEL_STORAGE_BACKEND=none

# ---- SIP/RTP/WebRTC ----
# Inbound: max time to take a routing decision.
MME_TEL_ANSWER_TIMEOUT_S=15
# Hard cap on call duration.
MME_TEL_MAX_CALL_DURATION_S=1800
# Outbound ring timeout.
MME_TEL_RING_TIMEOUT_S=45
# RTP range end.
MME_TEL_RTP_PORT_END=32768
# RTP range start (must match FreeSWITCH switch.conf).
MME_TEL_RTP_PORT_START=16384
# Transfer completion timeout.
MME_TEL_TRANSFER_TIMEOUT_S=30
# Browser calling. NOT implemented in Phase 2; must remain false.
MME_TEL_WEBRTC_ENABLED=False
