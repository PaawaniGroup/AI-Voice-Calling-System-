<!-- Isolated TEST context used by loopback integration tests. Never routes to carriers. Not for production. -->
<include>
  <context name="mme_test">
    <extension name="t_answer_park">
      <condition field="destination_number" expression="^9001$">
        <action application="ring_ready"/>
        <action application="sleep" data="300"/>
        <action application="answer"/>
        <action application="park"/>
      </condition>
    </extension>
    <extension name="t_busy">
      <condition field="destination_number" expression="^9002$">
        <action application="hangup" data="USER_BUSY"/>
      </condition>
    </extension>
    <extension name="t_noroute">
      <condition field="destination_number" expression="^9003$">
        <action application="respond" data="404"/>
      </condition>
    </extension>
    <extension name="t_bridge_target">
      <condition field="destination_number" expression="^9004$">
        <action application="answer"/>
        <action application="park"/>
      </condition>
    </extension>
    <extension name="t_ringing_long">
      <condition field="destination_number" expression="^9005$">
        <action application="ring_ready"/>
        <action application="sleep" data="30000"/>
        <action application="answer"/>
        <action application="park"/>
      </condition>
    </extension>
    <!-- AI media tests: B leg = the "caller". 9010: speaks once. 9011: speaks, then talks over the reply (barge-in).
         Records ONLY what the caller hears (RECORD_READ_ONLY) so tests can prove the AI reply audio arrived. -->
    <extension name="t_ai_caller_once">
      <condition field="destination_number" expression="^9010$">
        <action application="answer"/>
        <action application="set" data="RECORD_READ_ONLY=true"/>
        <action application="record_session" data="/tmp/mme_ai_heard_${uuid}.wav"/>
        <action application="sleep" data="1500"/>
        <action application="playback" data="/tmp/mme_ai_caller.wav"/>
        <action application="sleep" data="25000"/>
      </condition>
    </extension>
    <extension name="t_ai_caller_barge">
      <condition field="destination_number" expression="^9011$">
        <action application="answer"/>
        <action application="set" data="RECORD_READ_ONLY=true"/>
        <action application="record_session" data="/tmp/mme_ai_heard_${uuid}.wav"/>
        <action application="sleep" data="1500"/>
        <action application="playback" data="/tmp/mme_ai_caller.wav"/>
        <action application="sleep" data="2200"/>
        <action application="playback" data="/tmp/mme_ai_caller.wav"/>
        <action application="sleep" data="20000"/>
      </condition>
    </extension>
  </context>
</include>
